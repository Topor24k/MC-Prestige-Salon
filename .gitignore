# Dependencies — restored with `npm install`
node_modules/

# Build output — recreated with `npm run build`
dist/
dist-ssr/
.vite/

# Local environment files (can hold secrets)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test, lint and compiler caches
coverage/
.eslintcache
*.tsbuildinfo

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local tooling
.claude/
